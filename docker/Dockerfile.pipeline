# syntax=docker/dockerfile:1
FROM python:3.11-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    MPLCONFIGDIR=/tmp/matplotlib \
    JOBLIB_TEMP_FOLDER=/tmp/joblib
ARG APP_UID=10001
ARG APP_GID=10001
WORKDIR /app
# Use a stable non-root identity so Kubernetes securityContext settings and
# mounted-volume permissions can be configured consistently.
RUN groupadd --gid "${APP_GID}" appgroup \
    && useradd \
        --uid "${APP_UID}" \
        --gid "${APP_GID}" \
        --create-home \
        --home-dir /home/appuser \
        --shell /usr/sbin/nologin \
        appuser
# The KFP SDK is intentionally not installed here. It is needed to compile the
# pipeline, not to execute these container-component commands.
COPY requirements.txt ./requirements.txt
RUN python -m pip install --no-cache-dir -r requirements.txt
# Preserve the repository's current `src.*` imports. KFP components override
# this image's command and pass their artifact paths as command arguments.
COPY --chown=${APP_UID}:${APP_GID} src ./src
# Existing project logging writes a rotating file as well as console output.
# KFP captures console output; /app/logs remains writable for compatibility.
RUN mkdir -p /app/logs /tmp/matplotlib /tmp/joblib \
    && chown -R "${APP_UID}:${APP_GID}" \
        /app/logs /tmp/matplotlib /tmp/joblib
USER ${APP_UID}:${APP_GID}
# A safe diagnostic default for manual `docker run`. Kubeflow container
# components replace this command with their specific entry point.
CMD ["python", "-m", "src.churn_model.kubeflow.runtime", "--help"]
